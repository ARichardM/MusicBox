<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="8dp" android:insetBottom="8dp">
    <ripple android:color="@color/dialog_button_ripple">
        <item>
            <selector>
                <item android:state_selected="true">
                    <shape>
                        <solid android:color="@color/dialog_button_ripple"/>
                        <stroke android:width="1dp" android:color="@color/accent"/>
                        <corners android:radius="16dp"/>
                    </shape>
                </item>
                <item android:state_focused="true">
                    <shape>
                        <solid android:color="@color/bg_card"/>
                        <stroke android:width="1dp" android:color="@color/accent"/>
                        <corners android:radius="16dp"/>
                    </shape>
                </item>
                <item android:drawable="@drawable/bg_auto_dl_pill"/>
            </selector>
        </item>
    </ripple>
</inset>
