<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchResultRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="10dp" android:paddingBottom="10dp"
    android:background="?attr/selectableItemBackground">

    <!-- Marco con esquinas redondeadas: cuadrado para canciones, 16:9 para videos (lo fija el adaptador). -->
    <FrameLayout
        android:id="@+id/thumbFrame"
        android:layout_width="62dp"
        android:layout_height="62dp">
        <ImageView android:contentDescription="@null" android:importantForAccessibility="no" android:id="@+id/imgThumbnail" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="centerCrop"
            android:background="@drawable/bg_thumbnail"/>
        <!-- Sin ícono visible: la portada completa sigue siendo el botón de reproducir (sin abrir el reproductor). -->
        <ImageView android:id="@+id/btnPlayResult" android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/reproducir"/>
        <ImageView android:id="@+id/imgDownloadedResult" android:layout_width="24dp"
            android:layout_height="24dp" android:layout_gravity="top|end"
            android:layout_margin="3dp" android:padding="4dp"
            android:background="@drawable/bg_download_badge"
            android:src="@drawable/ic_downloaded_badge" android:visibility="gone"
            android:contentDescription="@string/descargada"/>
        <!-- Avance real de la descarga, compacto y en el mismo lugar de la marca de descargada -->
        <cl.arichard.descargador.util.LoadingRingView android:id="@+id/progressDownloadResult"
            android:layout_width="24dp" android:layout_height="24dp"
            android:layout_gravity="top|end" android:layout_margin="3dp" android:padding="4dp"
            android:background="@drawable/bg_download_badge"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/txtResultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/txtResultChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:singleLine="true"/>
    </LinearLayout>

    <ImageView android:id="@+id/btnFavoriteResult" android:layout_width="38dp"
        android:layout_height="38dp" android:padding="9dp" android:src="@drawable/ic_favorite"
        android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/me_gusta"/>

    <ImageView
        android:id="@+id/btnMoreResult"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:src="@drawable/ic_more_vert"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/mas_opciones_de_la_cancion"/>
</LinearLayout>
