<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchResultRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="10dp" android:paddingBottom="10dp"
    android:background="?attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="110dp"
        android:layout_height="62dp">
        <ImageView android:id="@+id/imgThumbnail" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="centerCrop"
            android:background="@drawable/bg_thumbnail"/>
        <ImageView android:id="@+id/btnPlayResult" android:layout_width="28dp"
            android:layout_height="28dp" android:layout_gravity="center"
            android:padding="5dp" android:src="@drawable/ic_play_arrow"
            android:background="@drawable/bg_play_circle" app:tint="#000000"
            android:contentDescription="Reproducir"/>
        <ImageView android:id="@+id/imgDownloadedResult" android:layout_width="28dp"
            android:layout_height="28dp" android:layout_gravity="top|end"
            android:padding="3dp" android:background="@drawable/bg_download_status"
            android:src="@drawable/ic_downloaded_badge" android:visibility="gone"
            android:contentDescription="Descargada"/>
        <ProgressBar android:id="@+id/progressDownloadResult"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="28dp" android:layout_height="28dp"
            android:layout_gravity="top|end" android:padding="4dp"
            android:background="@drawable/bg_download_status"
            android:indeterminate="true" android:indeterminateTint="@color/accent"
            android:visibility="gone"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/txtResultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/txtResultChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:singleLine="true"/>
    </LinearLayout>

    <ImageView android:id="@+id/btnFavoriteResult" android:layout_width="38dp"
        android:layout_height="38dp" android:padding="9dp" android:src="@drawable/ic_favorite"
        android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Me gusta"/>

    <FrameLayout
        android:id="@+id/btnAddResult"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_download_small">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_add"
            app:tint="#FFFFFF"/>
    </FrameLayout>
</LinearLayout>
