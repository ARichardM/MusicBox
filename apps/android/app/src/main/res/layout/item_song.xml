<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/songItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="?attr/selectableItemBackground">

    <!-- Full rounded album art thumbnail filling the frame completely -->
    <androidx.cardview.widget.CardView
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/bg_elevated">

        <ImageView
            android:id="@+id/imgSongCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_thumbnail"/>

        <View
            android:id="@+id/viewPlayingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#60000000"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/imgPlayingIndicator"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play_arrow"
            app:tint="@color/accent"
            android:visibility="gone"/>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/txtSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="marquee"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Compact Downloaded / Offline badge -->
            <ImageView
                android:id="@+id/imgDownloadedBadge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/descargada_en_el_dispositivo"
                android:layout_marginEnd="5dp"
                android:src="@drawable/ic_downloaded_badge"
                app:tint="@color/accent"
                android:visibility="visible"/>

            <cl.arichard.descargador.util.LoadingRingView
                android:id="@+id/progressSongDownload"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="5dp"/>

            <TextView
                android:id="@+id/txtSongSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"/>

            <!-- Clics: compact play counter, like YouTube views -->
            <TextView
                android:id="@+id/txtSongClicks"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:paddingStart="5dp"
                android:paddingEnd="6dp"
                android:gravity="center_vertical"
                android:background="@drawable/bg_clicks_chip"
                android:drawableStart="@drawable/ic_clicks"
                android:drawablePadding="3dp"
                android:drawableTint="@color/text_secondary"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:singleLine="true"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <cl.arichard.descargador.util.GuardedActionsLayout
        android:id="@+id/songActionZone"
        android:layout_width="78dp" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center">
    <ImageView
        android:id="@+id/btnFavorite"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:src="@drawable/ic_favorite"
        android:background="?attr/selectableItemBackgroundBorderless"/>

    <ImageView
        android:id="@+id/btnSongMenu"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:padding="6dp"
        android:src="@drawable/ic_more_vert"
        android:background="?attr/selectableItemBackgroundBorderless"/>
    </cl.arichard.descargador.util.GuardedActionsLayout>
</LinearLayout>
