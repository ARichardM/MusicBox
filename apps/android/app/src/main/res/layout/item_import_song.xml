<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp" android:gravity="center_vertical" android:orientation="horizontal"
    android:padding="12dp" android:background="@drawable/bg_settings_card">
    <TextView android:id="@+id/checkSong" android:layout_width="28dp" android:layout_height="28dp"
        android:gravity="center" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/txtSongTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"
            android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/txtSongSub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/text_secondary" android:textSize="12sp"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/txtSongWarn" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textColor="@color/heart_red" android:textSize="11.5sp" android:visibility="gone"/>
    </LinearLayout>
    <TextView android:id="@+id/btnSongDelete" android:layout_width="40dp" android:layout_height="40dp"
        android:gravity="center" android:text="✕" android:textColor="@color/text_secondary" android:textSize="15sp"/>
</LinearLayout>
