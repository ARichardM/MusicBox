<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nowPlayingCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

<cl.arichard.descargador.util.PlayerDismissLayout
    android:id="@+id/nowPlayingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="100dp">

    <!-- Top Bar: Back Chevron, Centered MP3/MP4 Pill, Favorite and Download -->
    <LinearLayout
        android:id="@+id/playerTopBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical">

        <ImageView android:contentDescription="@string/volver"
            android:id="@+id/btnBackNowPlaying"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Top Mode Selector: MP3 (Music with cover) | MP4 (Video while listening) -->
        <LinearLayout
            android:id="@+id/playerSelectorPill"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:visibility="gone"
            android:background="@drawable/bg_nav_island"
            android:padding="3dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabSelectorMp3"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:text="MP3"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/chip_active_text"
                android:background="@drawable/bg_chip_active"/>

            <TextView
                android:id="@+id/tabSelectorMp4"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:text="MP4"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:background="@null"/>

            <TextView
                android:id="@+id/tabSelectorLyrics"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:text="@string/letra"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:background="@null"/>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/btnNowPlayingFavorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_favorite"
            android:contentDescription="@string/agregar_a_favoritos"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <ImageView android:id="@+id/btnPlayerMore" android:layout_width="40dp"
            android:layout_height="40dp" android:padding="8dp" android:src="@drawable/ic_more_vert"
            app:tint="@color/text_primary" android:contentDescription="@string/mas_opciones_de_la_cancion"
            android:background="?attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>

    <!-- Where the music comes from: a folder, a playlist, all songs or a YouTube search. -->
    <LinearLayout
        android:id="@+id/playingFromBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/txtPlayingFromLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reproduciendo_desde"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"/>

        <TextView
            android:id="@+id/txtPlayingFromName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Artwork is the dedicated downward-dismiss gesture area. -->
    <FrameLayout android:id="@+id/playerArtworkArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:clipChildren="false"
        android:background="@android:color/transparent">

        <!-- MP3 Mode: Full Album Cover Art -->
        <FrameLayout
            android:id="@+id/containerCoverArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <!-- Marco cuadrado: el tamaño lo fija la pantalla (el menor lado libre), siempre 1:1. -->
            <androidx.cardview.widget.CardView
                android:id="@+id/discContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                app:cardCornerRadius="26dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1C1C1E">

                <ImageView android:contentDescription="@null" android:importantForAccessibility="no"
                    android:id="@+id/imgNowPlayingCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_thumbnail"/>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- MP4 Mode: Video Player (plays video while listening) -->
        <FrameLayout
            android:id="@+id/containerVideoPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:visibility="invisible">

            <!-- El tamaño y la posición los fija la pantalla: la proporción real del video, a todo el ancho, o la
                 pantalla completa al tocarlo. -->
            <androidx.cardview.widget.CardView
                android:id="@+id/videoCardView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="0dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="#000000">

                <FrameLayout
                    android:id="@+id/videoHostLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <!-- Pantalla completa: sombra bajo la barra superior y fundido hacia el fondo en la base. -->
                <View android:id="@+id/videoFadeTop"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_gravity="top"
                    android:alpha="0"
                    android:background="@drawable/bg_video_fade_top"/>
                <View android:id="@+id/videoFadeBottom"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_gravity="bottom"
                    android:alpha="0"
                    android:background="@drawable/bg_video_fade_bottom"/>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Lyrics Mode: Minimalist, reactive, synchronized lyrics card -->
        <FrameLayout
            android:id="@+id/containerLyrics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.cardview.widget.CardView
                android:id="@+id/lyricsCardView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="26dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Minimalist Header: Sync Badge, Source & Follow Button -->
                    <LinearLayout
                        android:id="@+id/lyricsHeaderRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/txtLyricsBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent"
                            android:background="@drawable/bg_nav_island"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/txtLyricsSource"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textSize="11sp"
                            android:textColor="@color/text_muted"/>

                        <TextView
                            android:id="@+id/btnLyricsFollow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/chip_active_text"
                            android:background="@drawable/bg_chip_active"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerLyrics"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:paddingTop="24dp"
                            android:paddingBottom="56dp"
                            android:overScrollMode="never"
                            android:scrollbars="none"/>

                        <LinearLayout
                            android:id="@+id/layoutLyricsLoading"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="24dp"
                            android:visibility="gone">

                            <ProgressBar
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:indeterminate="true"/>

                            <TextView
                                android:id="@+id/txtLyricsLoading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/buscando_letra"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutLyricsEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="28dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/txtLyricsEmptyTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/sin_letra_disponible"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/txtLyricsEmptyDetail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"/>

                            <TextView
                                android:id="@+id/btnLyricsRetry"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:paddingTop="7dp"
                                android:paddingBottom="7dp"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/chip_active_text"
                                android:background="@drawable/bg_chip_active"/>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>
    </FrameLayout>

    <!-- Song Info -->
    <TextView
        android:id="@+id/txtNowPlayingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:gravity="center"
        android:letterSpacing="-0.02"/>

    <TextView
        android:id="@+id/txtNowPlayingArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:gravity="center"/>

    <!-- Inline Download Progress Banner (when download is triggered from player) -->
    <LinearLayout
        android:id="@+id/playerDownloadCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:background="@drawable/bg_card"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtPlayerDownloadStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/descargando"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtPlayerDownloadEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conectando"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/playerDownloadProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:progress="0"
            android:max="100"/>
    </LinearLayout>

    <!-- Scrubber Seek Bar -->
    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:minHeight="3dp"
        android:maxHeight="3dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:progressDrawable="@drawable/player_seek_track"
        android:thumb="@drawable/player_seek_thumb"
        android:thumbOffset="0dp"
        android:splitTrack="false"
        android:progress="0"
        android:max="100"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/txtCurrentTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textColor="@color/text_muted"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txtTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@color/text_muted"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView android:id="@+id/txtRepeatMode" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="end" android:textSize="12sp"
        android:textColor="@color/text_secondary"/>

    <!-- Playback Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical">

        <ImageView android:contentDescription="@string/reproduccion_aleatoria"
            android:id="@+id/btnShuffle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="10dp"
            android:src="@drawable/ic_shuffle"
            app:tint="@color/text_muted"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <ImageView android:contentDescription="@string/anterior"
            android:id="@+id/btnPrevious"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:src="@drawable/ic_skip_previous"
            app:tint="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <FrameLayout
            android:id="@+id/btnPlayPauseCircle"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_play_circle">

            <ImageView android:contentDescription="@null" android:importantForAccessibility="no"
                android:id="@+id/btnPlayPauseIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_arrow"
                app:tint="@color/play_circle_icon"/>

            <cl.arichard.descargador.util.LoadingRingView
                android:id="@+id/playLoadingRing"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"/>
        </FrameLayout>

        <ImageView android:contentDescription="@string/siguiente"
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:src="@drawable/ic_skip_next"
            app:tint="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <ImageView
            android:id="@+id/btnRepeat"
            android:contentDescription="@string/cambiar_modo_de_bucle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="10dp"
            android:src="@drawable/ic_repeat"
            app:tint="@color/text_muted"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>
</cl.arichard.descargador.util.PlayerDismissLayout>

    <!-- Queue: peeks from the bottom edge and can be pulled up, like YouTube Music. -->
    <FrameLayout
        android:id="@+id/queueSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_queue_sheet"
        android:elevation="12dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
