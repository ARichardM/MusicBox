<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MusicBox" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowAnimationStyle">@style/WindowAnim</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MusicBox.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MusicBox.Dialog</item>
        <item name="popupMenuStyle">@style/Widget.MusicBox.PopupMenu</item>
        <item name="panelMenuListTheme">@style/ThemeOverlay.MusicBox.PopupMenu</item>
    </style>

    <style name="Theme.MusicBox.Starting" parent="Theme.MusicBox">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <style name="ThemeOverlay.MusicBox.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg_card</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MusicBox.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.MusicBox.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.MusicBox.DialogButton</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.MusicBox.Dialog.Title</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MusicBox.Dialog</item>
        <item name="editTextStyle">@style/Widget.MusicBox.DialogEditText</item>
    </style>

    <style name="ShapeAppearance.MusicBox.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="TextAppearance.MusicBox.Dialog.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.MusicBox.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="rippleColor">@color/dialog_button_ripple</item>
    </style>

    <style name="Widget.MusicBox.DialogEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="ThemeOverlay.MusicBox.PopupMenu" parent="ThemeOverlay.AppCompat">
        <item name="android:colorBackground">@color/bg_elevated</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorControlNormal">@color/text_primary</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.MusicBox.PopupMenu</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.MusicBox.PopupMenu</item>
    </style>

    <style name="Widget.MusicBox.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
        <item name="android:dropDownHorizontalOffset">0dp</item>
    </style>

    <style name="TextAppearance.MusicBox.PopupMenu" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Theme.MusicBox.NowPlaying" parent="Theme.MusicBox">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
    </style>
    <style name="WindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_up</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_down</item>
    </style>
    <style name="BulkAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="BulkActionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
